<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds shrink unused resources. Play services reads this list from outside the app,
     so the shrinker can't see it's used; without this it was stripped and the phone and watch
     couldn't find each other (the phone kept offering "Install on watch"). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@array/android_wear_capabilities" />
